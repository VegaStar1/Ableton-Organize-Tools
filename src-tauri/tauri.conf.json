{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ableton Organizer",
  "version": "0.1.0",
  "identifier": "app.abletonorganizer.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Ableton Organizer", "width": 1360, "height": 860, "minWidth": 1000, "minHeight": 640 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
